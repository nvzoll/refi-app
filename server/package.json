{
  "name": "refi-app",
  "productName": "refi2",
  "homepage": "https://github.com/nvzoll/refi-app",
  "authors": "mihthanh27@gmail.com",
  "version": "0.0.19",
  "description": "A tool to make developer less pain when developing application with Firestore indeed they will save move time to focus on building application instead of playing with poor DX product",
  "main": "server/index.js",
  "repository": "github:nvzoll/refi-app",
  "scripts": {
    "clean": "rm -fr dist",
    "watch": "tsc -w",
    "dev": "run-p --race watch start",
    "start": "electron server/index.js",
    "build": "todesktop build",
    "quick-build": "todesktop build . --code-sign=false",
    "release-todesktop": "todesktop build && todesktop release --latest --force",
    "copy-fe": "rm -rf build && cp -R ../vite/dist ./build",
    "build-ts": "tsc --sourceMap false",
    "prepare": "bun run --cwd ../firestore-serializers build && bun run build-ts",
    "package": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "release": "electron-builder",
    "release-wl": "electron-builder -wl",
    "test": "bun test"
  },
  "keywords": [],
  "author": {
    "name": "Thanh Le",
    "email": "mihthanh27@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "electron": "45.2.3",
    "electron-builder": "^23.0.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-notarize": "^1.0.0",
    "npm-run-all": "^4.1.5",
    "refi-ipc": "workspace:*",
    "source-map-support": "^0.5.19",
    "terser": "^5.6.1",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@todesktop/runtime": "^0.6.5",
    "axios": "^1.21.0",
    "electron-is-dev": "^1.2.0",
    "electron-log": "^5.4.4",
    "electron-serve": "^3.0.1",
    "electron-squirrel-startup": "^1.0.0",
    "es-toolkit": "^1.53.1",
    "firebase-admin": "^14.5.0",
    "firestore-serializers": "workspace:*",
    "uuid": "^14.0.3"
  },
  "build": {
    "appId": "com.nvzoll.refi2",
    "productName": "refi2",
    "asar": false,
    "npmRebuild": false,
    "afterSign": "notarize.js",
    "mac": {
      "icon": "./assets/icon.icns",
      "entitlements": "entitlements.plist",
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "win": {
      "icon": "./assets/icon.ico"
    },
    "linux": {
      "target": "deb",
      "icon": "./assets/icon.png"
    },
    "files": [
      "**/*",
      "server/**/*",
      "build/**/*",
      "!out/**",
      "!key/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nvzoll",
        "private": false,
        "releaseType": "draft"
      }
    ]
  }
}
