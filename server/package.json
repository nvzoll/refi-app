{
  "name": "refi-app",
  "productName": "refi2",
  "homepage": "https://github.com/nvzoll/refi-app",
  "authors": "mihthanh27@gmail.com",
  "version": "0.0.19",
  "description": "A tool to make developer less pain when developing application with Firestore indeed they will save move time to focus on building application instead of playing with poor DX product",
  "main": "out/main/index.js",
  "repository": "github:nvzoll/refi-app",
  "scripts": {
    "clean": "rm -fr dist out",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "package": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "release": "electron-builder",
    "test": "bun test"
  },
  "keywords": [],
  "author": {
    "name": "Thanh Le",
    "email": "mihthanh27@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0",
    "refi-ipc": "workspace:*",
    "source-map-support": "^0.5.19",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "electron-is-dev": "^1.2.0",
    "electron-log": "^5.4.4",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.11",
    "es-toolkit": "^1.53.1",
    "firebase-admin": "^14.5.0",
    "firestore-serializers": "workspace:*",
    "uuid": "^14.0.3"
  },
  "build": {
    "appId": "com.nvzoll.refi2",
    "productName": "refi2",
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "icon": "./assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "entitlementsInherit": "entitlements.plist",
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "win": {
      "icon": "./assets/icon.ico"
    },
    "linux": {
      "executableName": "refi2",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "./assets/icon.png",
      "category": "Development"
    },
    "files": [
      "out/**/*",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nvzoll",
        "repo": "refi-app",
        "private": false,
        "releaseType": "draft"
      }
    ]
  }
}
